type frankd, domain;
type frankd_exec, exec_type, system_file_type, file_type;
type frank_policy_service, service_manager_type;

init_daemon_domain(frankd)

# Keep the daemon intentionally constrained. Add only narrowly-reviewed
# permissions as concrete brokers are integrated.
allow frankd self:process { getpgid getsched setsched signal };
allow frankd frank_policy_service:service_manager { add find };
